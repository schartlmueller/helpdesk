# Nach .env kopieren und anpassen. Ohne .env gelten die Standardwerte aus docker-compose.yml.
# Nach jeder Änderung: docker compose up -d

PORT=8000
SECRET_KEY=hier-eine-lange-zufaellige-zeichenkette
POSTGRES_PASSWORD=sicheres-datenbank-passwort

# Erster Administrator (wird nur angelegt, solange es noch keinen gibt)
ADMIN_USER=admin
ADMIN_PASSWORD=sicheres-admin-passwort
ADMIN_EMAIL=admin@example.com

# Adresse, unter der das System erreichbar ist (fuer Links in E-Mails)
SITE_URL=http://localhost:8000
TIME_ZONE=Europe/Vienna
ALLOWED_HOSTS=*
# Bei Betrieb hinter einem Reverse Proxy mit HTTPS, z. B. https://helpdesk.firma.at
CSRF_TRUSTED_ORIGINS=
BEHIND_HTTPS_PROXY=0

# Dateianhaenge: Hoechstgroesse je Datei in MB
MAX_UPLOAD_MB=20
# Virenpruefung: CLAMAV_HOST=clamav setzen und mit
#   docker compose --profile clamav up -d   starten
CLAMAV_HOST=

# --- Zielzeiten ---
# 1 = nur innerhalb der Geschaeftszeiten zaehlen, 0 = rund um die Uhr
SLA_BUSINESS_HOURS=1
BUSINESS_OPEN=08:00
BUSINESS_CLOSE=17:00
# Arbeitstage: 1 = Montag ... 7 = Sonntag
BUSINESS_DAYS=1,2,3,4,5
# Stunden je Prioritaet (leer = Standard: 4 / 8 / 24 / 56 Arbeitsstunden)
SLA_HOURS_URGENT=
SLA_HOURS_HIGH=
SLA_HOURS_NORMAL=
SLA_HOURS_LOW=
# Stunden bis zur ersten Antwort (leer = Standard: 1 / 2 / 8 / 16 Arbeitsstunden)
SLA_RESPONSE_HOURS_URGENT=
SLA_RESPONSE_HOURS_HIGH=
SLA_RESPONSE_HOURS_NORMAL=
SLA_RESPONSE_HOURS_LOW=
# Gesetzliche Feiertage automatisch eintragen: AT, DE oder leer fuer keine.
# Regionale Feiertage und Betriebsurlaub unter Verwaltung -> Feiertage ergaenzen.
HOLIDAY_COUNTRY=AT

# --- Automatisches Erinnern und Schliessen (0 = aus) ---
# Geloeste Tickets nach so vielen Tagen schliessen
AUTO_CLOSE_DAYS=7
# "Wartet auf Rueckmeldung": Melder nach so vielen Tagen erinnern ...
WAITING_REMINDER_DAYS=3
# ... und nach so vielen Tagen ohne Antwort schliessen
WAITING_CLOSE_DAYS=10

# --- Zeiterfassung, Sicherung, Loeschfristen, Anmeldeschutz ---
# Vergessene Uhr nach so vielen Stunden stoppen
TIMER_MAX_HOURS=10
# Sicherungen in ./backups so viele Tage aufbewahren
BACKUP_KEEP_DAYS=14
# Abgeschlossene Tickets nach so vielen Tagen loeschen (0 = nie)
RETENTION_DAYS=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- E-Mail-Versand (leer = E-Mails werden nur ins Container-Log geschrieben) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=helpdesk@example.com

# --- E-Mail-Eingang per IMAP (leer = aus) ---
# DEFAULT_FROM_EMAIL sollte die Adresse dieses Postfachs sein, damit Antworten ankommen.
IMAP_HOST=
IMAP_PORT=
IMAP_SSL=1
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
MAIL_POLL_SECONDS=60
# Nur E-Mails von diesen Domains annehmen, z. B. firma.at,tochter.at (leer = alle)
MAIL_ALLOWED_DOMAINS=
# Microsoft 365 ohne Passwort-Anmeldung (dann IMAP_PASSWORD leer lassen,
# IMAP_HOST=outlook.office365.com, IMAP_USER=Postfachadresse)
IMAP_OAUTH_TENANT=
IMAP_OAUTH_CLIENT_ID=
IMAP_OAUTH_CLIENT_SECRET=

# --- LDAP / Active Directory (leer = aus) ---
# LDAP_SERVER_URI=ldaps://dc01.firma.local
# LDAP_BIND_DN=CN=svc-helpdesk,OU=Dienstkonten,DC=firma,DC=local
# LDAP_BIND_PASSWORD=...
# LDAP_USER_BASE=OU=Benutzer,DC=firma,DC=local
# Fuer OpenLDAP z. B. (uid=%(user)s); Standard ist (sAMAccountName=%(user)s)
# LDAP_USER_FILTER=
# LDAP_START_TLS=0
# Gruppen fuer die Rollen (vollstaendiger DN); ad = Active Directory, sonst groupOfNames
# LDAP_GROUP_TYPE=ad
# LDAP_GROUP_BASE=OU=Gruppen,DC=firma,DC=local
# LDAP_STAFF_GROUP=CN=Helpdesk-Bearbeiter,OU=Gruppen,DC=firma,DC=local
# LDAP_ADMIN_GROUP=CN=Helpdesk-Admins,OU=Gruppen,DC=firma,DC=local

# --- Single Sign-On per OpenID Connect (leer = aus) ---
# Redirect-URI beim Anbieter eintragen: <SITE_URL>/oidc/callback/
# Beispiel Microsoft Entra ID (TENANT ersetzen):
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/TENANT/oauth2/v2.0/authorize
# OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/TENANT/oauth2/v2.0/token
# OIDC_USER_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
# OIDC_JWKS_ENDPOINT=https://login.microsoftonline.com/TENANT/discovery/v2.0/keys
# Optional: Bearbeiter-Rolle ueber eine Gruppe im Token (Claim "groups")
# OIDC_STAFF_GROUP=
# OIDC_GROUPS_CLAIM=groups
